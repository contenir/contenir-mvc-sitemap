{
    "name": "contenir/contenir-sitemap-laminas-mvc",
    "description": "Contenir MVC Sitemap",
    "license": "BSD-3-Clause",
    "type": "library",
    "keywords": [
        "contenir",
        "laminas",
        "mvc"
    ],
    "homepage": "https://contenir.com.au",
    "support": {
        "docs": "https://github.com/contenir/contenir-sitemap-laminas-mvc#readme",
        "issues": "https://contenir.com.au/issues",
        "source": "https://github.com/contenir/contenir-sitemap-laminas-mvc"
    },
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
        "laminas/laminas-http": "^2.19",
        "laminas/laminas-mvc": "^3.8",
        "laminas/laminas-navigation": "^2.19",
        "laminas/laminas-router": "^3.13",
        "laminas/laminas-servicemanager": "^3.22 || ^4.0",
        "laminas/laminas-view": "^2.35",
        "psr/container": "^1.1 || ^2.0"
    },
    "require-dev": {
        "infection/infection": "^0.34.1",
        "php-db/phpdb-qa-tools": "0.1.x-dev",
        "phpunit/phpunit": "^11.5.42"
    },
    "replace": {
        "contenir/contenir-mvc-sitemap": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Contenir\\Mvc\\Sitemap\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Contenir\\Mvc\\Sitemap\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@static-analysis",
            "@test",
            "@test-integration",
            "@mutation-test"
        ],
        "cs-check": [
            "mago format --check",
            "mago lint"
        ],
        "cs-fix": [
            "mago format",
            "mago lint --fix"
        ],
        "static-analysis": "mago analyze",
        "test": "phpunit --colors=always --testsuite unit",
        "test-integration": "phpunit --colors=always --testsuite integration",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml",
        "mutation-test": "infection"
    },
    "config": {
        "platform": {
            "php": "8.3.99"
        },
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.1.x-dev"
        },
        "laminas": {
            "component": "Contenir\\Mvc\\Sitemap"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
